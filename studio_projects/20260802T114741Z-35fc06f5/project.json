      },
      "caption": "q_1K^{\\mathsf T}=\\begin{bmatrix}1&2&1&-1\\end{bmatrix}",
      "seconds": 9.0,
      "overrides": {},
      "bridge": "",
      "narration": "The query takes a dot product with each key. The four raw similarities are one, two, one, and negative one, so key two scores highest.",
      "code": "",
      "loop": false,
      "origin": "agent",
      "locked": false
    },
    {
      "id": "s4",
      "title": "Scale the scores",
      "component": "equation_chain",
      "parameters": {
        "steps": [
          "d_k=2",
          "\\widetilde{s}=\\frac{q_1K^{\\mathsf T}}{\\sqrt{d_k}}",
          "\\widetilde{s}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1&2&1&-1\\end{bmatrix}",
          "\\widetilde{s}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}}&\\sqrt{2}&\\frac{1}{\\sqrt{2}}&-\\frac{1}{\\sqrt{2}}\\end{bmatrix}"
        ]
      },
      "caption": "\\widetilde{s}=\\frac{q_1K^{\\mathsf T}}{\\sqrt{d_k}}",
      "seconds": 7.0,
      "overrides": {},
      "bridge": "",
      "narration": "Because the key dimension is two, divide every score by the square root of two before applying softmax.",
      "code": "",
      "loop": false,
      "origin": "agent",
      "locked": false
    },
    {
      "id": "s5",
      "title": "Softmax turns scores into weights",
      "component": "grid_map",
      "parameters": {
