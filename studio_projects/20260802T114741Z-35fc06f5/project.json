        "region": "stage"
      },
      "caption": "\\alpha_i=\\frac{e^{\\widetilde{s}_i}}{\\sum_{j=1}^{4}e^{\\widetilde{s}_j}}",
      "seconds": 10.0,
      "overrides": {},
      "bridge": "",
      "narration": "Softmax exponentiates each scaled score and divides by the total of all four exponentials. The result is a set of nonnegative weights.",
